# AajooBackend env vars — copy to `.env` and fill in real values.
# Never commit the populated `.env` file (it's gitignored).

# ─── Database ──────────────────────────────────────────────────────
# Note: production reads from config/db.config.js (Clever Cloud).
# These DB_* vars are for local dev / Sequelize CLI if you point it
# at a separate dev database.
DATABASE_URL=
DB_DIALECT=mysql
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=3306
DB_URI=
DB_USER=
LOGGING=true

# ─── App ───────────────────────────────────────────────────────────
PORT=8080
FRONTEND_URL=http://localhost:5173

# ─── Razorpay (single source of truth — see config/payments.config.js) ──
# Test mode (default; safe for dev + Render staging):
RAZORPAY_KEY_ID=rzp_test_XUTODhUdMAshi6
RAZORPAY_KEY_SECRET=pquKHeZnpWnSJgMGiqF6EuOy
# For production: set rzp_live_* values in Render Dashboard → Environment.
# DO NOT commit live keys here.

# ─── OTP dev bypass ────────────────────────────────────────────────
# When true, code "0000" verifies any account. REMOVE before public launch
# (cleanup task E4 in MASTER_TASK_TRACKER.md).
OTP_DEV_BYPASS=true

# ─── Cloudinary (image upload — used by utils/cloudinary.js) ───────
CLOUDINARY_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_SECRET=

# ─── Mail (legacy nodemailer SMTP — fallback path, used by utils/mailer.js) ──────────────
# SMTP is blocked on Render's free tier. Used only when BREVO_API_KEY is unset
# (i.e. local dev). For production, use the Brevo HTTP API block below.
MAIL_EMAIL=
MAIL_PASSWORD=

# ─── Mail (Brevo HTTP API — PRODUCTION path, see config/mail.config.js) ────
# When BREVO_API_KEY is set, utils/mailer.js sends via Brevo HTTP API (port 443,
# Render-friendly) instead of SMTP. To go live:
#   1. Create Brevo account, verify sender domain (SPF/DKIM).
#   2. Set these in Render Dashboard → Environment:
#   3. Restart. Boot log shows "Mail transport: BREVO_HTTP".
# No code change required (same cutover pattern as Razorpay PAY-03).
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Aajoo Homes
# BREVO_API_URL=https://api.brevo.com/v3/smtp/email  # override only if needed

# ─── Clever Cloud DB (override db.config.js fallbacks) ─────────────
# Leave unset to use the committed dev/prod values in config/db.config.js.
CLEVER_DB_USER=
CLEVER_DB_PASSWORD=
CLEVER_DB_NAME=
CLEVER_DB_HOST=
CLEVER_DB_PORT=21035
# CLEVER_DB_DIALECT=mysql

# ─── WhatsApp / BotPenguin (currently vestigial — activate when webhook lands) ──
WHATSAPP_VERIFY_TOKEN=

# ─── Google OAuth (currently vestigial — uncomment when Google sign-in is wired) ──
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── BotPenguin / Chatbot (optional — only needed when chatbot is active) ─
BOTPENGUIN_DEFAULT_COUNTRY_CODE=91
BOTPENGUIN_24HR_OFFER_AMOUNT=500
# BOTPENGUIN_2HR_TEMPLATE_ID=
# BOTPENGUIN_2HR_NO_CITY_TEMPLATE_ID=
# BOTPENGUIN_24HR_TEMPLATE_ID=
# BOTPENGUIN_24HR_NO_CITY_TEMPLATE_ID=
# BOTPENGUIN_TEMPLATE_ASSIGN_TO=
