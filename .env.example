# API Base URL (required in production)
VITE_API_BASE_URL=http://localhost:8000

# Razorpay publishable key — single source of truth for the web app
# (src/components/frontend/RazorpayPayment.tsx reads this).
# Test mode (safe for dev + staging); for production set rzp_live_* in your
# hosting dashboard (Vercel / Netlify env), NEVER commit live keys here.
VITE_RAZORPAY_KEY=rzp_test_XUTODhUdMAshi6

# Optional local-only admin login bypass (frontend dev only)
# WARNING: Keep this disabled in production/staging environments.
VITE_ENABLE_DEV_ADMIN_BYPASS=false
VITE_DEV_ADMIN_EMAIL=admin@aajao.test
VITE_DEV_ADMIN_PASSWORD=Admin@12345
VITE_DISABLE_ADMIN_AUTH=false

# Optional local FMS (finance) mock mode (frontend dev only, DEV builds only)
# Set true to show the local mock finance dashboard when the FMS API is down.
# Keep false to render real data from the 27 /admin/finance/* endpoints (A-03..06).
VITE_USE_FINANCE_MOCKS=false

# Optional local host portal mock mode (frontend dev only)
# Set true to show mock host portal data (statements/support/performance) when
# host APIs are unavailable. Keep false to render real /host/* data (A-07).
VITE_USE_HOST_MOCKS=false

# Optional admin notification center mock mode (frontend dev only)
# Set true to seed the admin Notification Center with local mock items.
# A-14 shipped GET /admin/notifications/search → default false (real, wired B-09).
VITE_USE_NOTIFY_MOCKS=false

# Staging integration runner
STAGING_API_BASE_URL=http://localhost:8000
STAGING_BEARER_TOKEN=

# Optional test IDs for detail and write-path checks
FINANCE_TEST_HOST_ID=
FINANCE_TEST_USER_ID=
FINANCE_TEST_LEDGER_ID=
FINANCE_TEST_PAYOUT_ID=
FINANCE_TEST_INVOICE_ID=
FINANCE_TEST_RECON_ID=
FINANCE_TEST_SCHEDULE_ID=
