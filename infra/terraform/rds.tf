/**
 * RDS MySQL 8, private, and a password nobody ever types.
 *
 * The plan's §3 says all secrets go to SSM Parameter Store as SecureString,
 * "none in the image, none in git, none in chat". The master password is the
 * first test of that rule, so it is generated here and written straight to SSM:
 * it is never typed, never pasted, and never appears in a message. It does land
 * in terraform.tfstate, which is why .gitignore excludes state and why the
 * remote backend in versions.tf is encrypted.
 */

resource "aws_db_subnet_group" "main" {
  name       = "${local.name}-db"
  subnet_ids = aws_subnet.private[*].id
  tags       = { Name = "${local.name}-db" }
}

resource "random_password" "db" {
  length  = 32
  special = true
  # RDS refuses /, @, " and space in a master password.
  override_special = "!#$%^&*()-_=+[]{}<>:?"
}

resource "aws_ssm_parameter" "db_password" {
  name        = "/aajoo/${var.env}/DB_PASSWORD"
  description = "RDS master password. Generated by Terraform; never typed."
  type        = "SecureString"
  value       = random_password.db.result

  tags = { Name = "${local.name}-db-password" }
}

/**
 * The connection string the API actually reads, assembled once here.
 *
 * The backend's config expects the pieces separately today, so both are
 * written: the individual parameters for the task definition to inject, and
 * the URL for anything that wants one. Assembling it here rather than in the
 * task definition means the endpoint is written down in exactly one place.
 */
resource "aws_ssm_parameter" "db_host" {
  name  = "/aajoo/${var.env}/DB_HOST"
  type  = "String"
  value = aws_db_instance.main.address
  tags  = { Name = "${local.name}-db-host" }
}

resource "aws_ssm_parameter" "db_name" {
  name  = "/aajoo/${var.env}/DB_NAME"
  type  = "String"
  value = var.db_name
  tags  = { Name = "${local.name}-db-name" }
}

resource "aws_ssm_parameter" "db_user" {
  name  = "/aajoo/${var.env}/DB_USER"
  type  = "String"
  value = var.db_username
  tags  = { Name = "${local.name}-db-user" }
}

resource "aws_db_instance" "main" {
  identifier     = "${local.name}-mysql"
  engine         = "mysql"
  engine_version = "8.0"
  instance_class = var.db_instance_class

  db_name  = var.db_name
  username = var.db_username
  password = random_password.db.result

  allocated_storage     = var.db_allocated_storage
  max_allocated_storage = 100 # storage autoscaling, so a full disk is not an outage
  storage_type          = "gp3"
  storage_encrypted     = true

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.rds.id]

  /**
   * Not publicly accessible, and in a subnet with no route out.
   *
   * Two independent reasons it cannot be reached from the internet, because
   * one of them will eventually be changed by somebody in a hurry.
   */
  publicly_accessible = false

  backup_retention_period = var.backup_retention_days
  backup_window           = "19:30-20:30" # 01:00-02:00 IST, the quietest hour
  maintenance_window      = "sun:20:30-sun:21:30"

  # Point-in-time recovery is what backup_retention_period buys; these make the
  # rest of an incident legible.
  performance_insights_enabled = true
  enabled_cloudwatch_logs_exports = ["error", "slowquery"]

  auto_minor_version_upgrade = true
  deletion_protection        = var.db_deletion_protection

  /**
   * A final snapshot, always.
   *
   * skip_final_snapshot = true is how a database disappears during a
   * `terraform destroy` somebody ran in the wrong directory.
   */
  skip_final_snapshot       = false
  final_snapshot_identifier = "${local.name}-mysql-final"

  # Single-AZ at launch. Multi-AZ doubles the instance cost and buys failover
  # the platform cannot yet use: the API runs at exactly one task.
  multi_az = false

  tags = { Name = "${local.name}-mysql" }
}
