# Copy to .env.aws, fill in, and run ./put-parameters.sh .env.aws prod
# NEVER commit the filled-in file. .gitignore in this directory covers it.
#
# The four Terraform cannot invent. A JWT secret generated fresh would sign
# every existing session out at cutover, and the Cloudinary keys belong to an
# account that already exists.
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Absent is fine and honest — requiredEnv.js degrades the feature and
# /health/env reports it missing. Present-but-empty is the thing to avoid.
MAIL_EMAIL=
MAIL_PASSWORD=
MAIL_FROM=
BREVO_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Without this a host CANNOT SAVE A PAYOUT ACCOUNT AT ALL — the handler fails
# closed rather than writing a bank account number in plaintext. It was on
# neither list once, and the first anyone knew was a host seeing "the server is
# missing its encryption key". NEVER rotate it: it decrypts what is already stored.
FIELD_ENCRYPTION_KEY=

FRONTEND_URL=https://www.aajoohomes.com
DB_DIALECT=mysql
BOTPENGUIN_API_TOKEN=
ADMIN_API_TOKEN=
FIREBASE_PROJECT_ID=
SAFETY_ALERT_EMAIL=

# The migration's own gate. /health/env is only readable with this, and it has
# been unset on Render since the last cutover — which is why nobody has ever
# checked the environment from outside. Set it to anything long and random.
HEALTH_TOKEN=
